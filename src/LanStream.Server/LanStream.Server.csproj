<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LanStream.Network\LanStream.Network.csproj" />
    <ProjectReference Include="..\LanStream.Shared\LanStream.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\models\haarcascade_frontalface_default.xml"
             Link="assets\models\haarcascade_frontalface_default.xml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
